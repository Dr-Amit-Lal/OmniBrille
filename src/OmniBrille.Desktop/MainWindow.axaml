<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:OmniBrille.Desktop.Rendering"
        x:Class="OmniBrille.Desktop.MainWindow" x:CompileBindings="False"
        Title="Spatial Explorer" FontSize="14" FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Width="1400" Height="900" MinWidth="820" MinHeight="520"
        Icon="/Assets/OmniBrille.ico" WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090D16" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#EE101725" />
          <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FA151D2D" />
          <SolidColorBrush x:Key="BorderBrush" Color="#53627C" />
          <SolidColorBrush x:Key="HairlineBrush" Color="#503F506B" />
          <SolidColorBrush x:Key="AccentBrush" Color="#B2C5FF" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#263A76C4" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDF2FC" />
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#ACB8D0" />
          <SolidColorBrush x:Key="LoadingOverlayBrush" Color="#F2090D16" />
          <SolidColorBrush x:Key="LoadingTextBrush" Color="#D4DFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#101725" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B2C5FF" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EDF2FC" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#ACB8D0" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.floating"><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="Border.panel"><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="Button.hud"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Button.hud:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.hud:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.active"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" /></Style>
    <Style Selector="ComboBox.hud"><Setter Property="CornerRadius" Value="8" /><Setter Property="MinHeight" Value="44" /></Style>
    <Style Selector="TextBox.hud"><Setter Property="CornerRadius" Value="8" /><Setter Property="MinHeight" Value="44" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,3" /><Setter Property="CornerRadius" Value="9" /><Setter Property="MinHeight" Value="68" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#453C2B12" /><Setter Property="BorderBrush" Value="#D7B568" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#453C2B12" /><Setter Property="BorderBrush" Value="#D7B568" /><Setter Property="BorderThickness" Value="1" /></Style>
  </Window.Styles>
  <Grid>
    <rendering:GraphSceneControl x:Name="GraphScene" ScenePadding="340,180,30,100" AutomationProperties.Name="Folder workspace" />
    <Grid x:Name="TitleBar" Height="44" VerticalAlignment="Top" ColumnDefinitions="*,Auto" PointerPressed="OnTitlePointerPressed">
      <TextBlock Text="Spatial Explorer" FontWeight="SemiBold" FontSize="19" Margin="20,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
        <Button Classes="hud icon" Content="−" Click="OnMinimizeClick" AutomationProperties.Name="Minimize window" />
        <Button Classes="hud icon" Content="□" Click="OnMaximizeClick" AutomationProperties.Name="Maximize window" />
        <Button Classes="hud icon" Content="×" Click="OnCloseClick" AutomationProperties.Name="Close window" />
      </StackPanel>
    </Grid>
    <Border x:Name="Toolbar" Classes="floating" VerticalAlignment="Top" Margin="16,50,16,0" Padding="8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Button x:Name="WorkspaceButton" Classes="hud" Content="Workspace" Click="OnWorkspaceClick" AutomationProperties.Name="Show all workspace folders" />
          <Button x:Name="BackButton" Classes="hud" Content="← Back" Click="OnUpClick" AutomationProperties.Name="Step back toward workspace" />
          <Button x:Name="UpButton" Classes="hud" Content="↑ Up" Click="OnUpClick" AutomationProperties.Name="Go to containing folder" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
          <Button x:Name="ChooseFolderButton" Classes="hud" Content="Choose folder" Click="OnChooseFolderClick" AutomationProperties.Name="Choose folders to add to workspace" />
          <Button x:Name="SearchToggleButton" Classes="hud icon" Content="⌕" Click="OnSearchToggleClick" AutomationProperties.Name="Search workspace" />
          <ComboBox x:Name="ThemePicker" Classes="hud" Width="104" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Color theme">
            <ComboBoxItem Content="Nebula" /><ComboBoxItem Content="Light" />
          </ComboBox>
          <Button x:Name="SettingsButton" Classes="hud icon" Content="⚙" Click="OnSettingsClick" AutomationProperties.Name="Appearance settings" />
          <Button x:Name="InterfaceToggleButton" Classes="hud icon" Content="◫" Click="OnInterfaceToggleClick" AutomationProperties.Name="Hide controls" ToolTip.Tip="Hide controls · Ctrl+H" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="SidePanel" Classes="panel" Width="304" HorizontalAlignment="Left" Margin="16,132,0,76" Padding="12">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid x:Name="SidebarTabs" ColumnDefinitions="*,*,44" ColumnSpacing="3">
          <Button x:Name="PinnedTabButton" Classes="hud active" Content="Pinned" Click="OnPinnedTabClick" AutomationProperties.Name="Show pinned folders" />
          <Button x:Name="SearchTabButton" Grid.Column="1" Classes="hud" Content="Search" Click="OnSearchToggleClick" AutomationProperties.Name="Show workspace search" />
          <Button x:Name="CollapsePinsButton" Grid.Column="2" Classes="hud icon" Content="‹" Click="OnCollapseSidebarClick" AutomationProperties.Name="Collapse sidebar" />
        </Grid>
        <Grid x:Name="PinnedPanel" Grid.Row="1" RowDefinitions="*,Auto">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="Pinned folders" FontSize="16" FontWeight="SemiBold" Margin="8,0" />
              <Border Height="1" Background="{DynamicResource HairlineBrush}" />
              <TextBlock x:Name="PinsEmptyText" Text="Pin a folder to keep it close." TextWrapping="Wrap" Margin="8,8" Foreground="{DynamicResource SecondaryTextBrush}" />
              <StackPanel x:Name="PinnedEntries" Spacing="4" />
              <Button x:Name="PinCurrentFolderButton" Classes="hud" Content="+ Pin current folder" HorizontalAlignment="Stretch" Click="OnPinCurrentClick" AutomationProperties.Name="Pin current folder" />
              <Button x:Name="PinFolderButton" Classes="hud" Content="Choose a folder to pin" HorizontalAlignment="Stretch" Click="OnPinFolderClick" AutomationProperties.Name="Choose a folder to pin" />
              <TextBlock Text="Drag pins to reorder" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
              <Border Height="1" Margin="0,8" Background="{DynamicResource HairlineBrush}" />
              <TextBlock Text="Workspace folders" FontSize="16" FontWeight="SemiBold" Margin="8,0" />
              <StackPanel x:Name="RootsEntries" Spacing="4" />
            </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="SavedStatusText" Grid.Row="1" Margin="8,14,8,2" Text="Workspace saved" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
        <Grid x:Name="SearchPanel" Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsVisible="False">
          <Grid x:Name="SearchInputPanel" ColumnDefinitions="*,44">
            <TextBox x:Name="SearchBox" Classes="hud" PlaceholderText="Search workspace" TextChanged="OnSearchTextChanged" AutomationProperties.Name="Search chosen workspace folders" />
            <Button x:Name="SearchButton" Grid.Column="1" Classes="hud icon" Content="↵" Click="OnSearchClick" AutomationProperties.Name="Run workspace search" />
          </Grid>
          <TextBlock x:Name="SearchSummaryText" Grid.Row="1" Text="All workspace folders" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
          <ListBox x:Name="SearchResultsList" Grid.Row="2" Focusable="True" Background="Transparent" BorderThickness="0" SelectionChanged="OnSearchSelectionChanged" AutomationProperties.Name="Workspace search results" />
          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="ShowResultButton" Classes="hud" Content="Show in map" Click="OnShowResultClick" IsEnabled="False" HorizontalAlignment="Stretch" AutomationProperties.Name="Show selected search result in map" />
            <Button x:Name="CloseSearchButton" Grid.Column="1" Classes="hud" Content="Close" Click="OnPinnedTabClick" HorizontalAlignment="Stretch" AutomationProperties.Name="Close search and show pins" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="BreadcrumbPanel" Classes="floating" Padding="18,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="320,128,0,0" MaxWidth="600">
      <StackPanel Spacing="3">
        <TextBlock x:Name="BreadcrumbText" Text="Workspace" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="BreadcrumbDetailText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
    <Border x:Name="WelcomePanel" Classes="panel" Width="400" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="320,70,0,0">
      <StackPanel Spacing="14">
        <TextBlock Text="Your folders, together" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="Choose the folders you want in your workspace. Each gets its own cluster, and your choices are saved automatically." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Button Classes="hud" Content="Choose folder" HorizontalAlignment="Center" Click="OnChooseFolderClick" AutomationProperties.Name="Choose your first workspace folders" />
      </StackPanel>
    </Border>
    <Border x:Name="SettingsPanel" Classes="panel" Width="294" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,128,16,0" IsVisible="False">
      <StackPanel Spacing="12">
        <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" />
        <CheckBox x:Name="ReducedMotionToggle" Content="Reduce motion" IsCheckedChanged="OnPreferencesChanged" />
        <CheckBox x:Name="ReducedEffectsToggle" Content="Reduce glow" IsCheckedChanged="OnPreferencesChanged" />
        <Button x:Name="RefreshButton" Classes="hud" Content="Refresh workspace" Click="OnRefreshClick" />
        <Button Classes="hud" Content="Close" Click="OnSettingsClick" />
      </StackPanel>
    </Border>
    <Border x:Name="FileDetailsPanel" Classes="panel" Width="300" Padding="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,76" IsVisible="False">
      <StackPanel Spacing="10">
        <TextBlock x:Name="SelectedFileText" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock x:Name="SelectedFilePathText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Button x:Name="OpenFileButton" Classes="hud" Content="Open file" Click="OnOpenFileClick" />
      </StackPanel>
    </Border>
    <Border x:Name="ZoomHud" Classes="floating" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="5">
      <StackPanel Orientation="Horizontal">
        <Button Classes="hud icon" Content="−" Click="OnZoomOutClick" AutomationProperties.Name="Zoom out" />
        <Button Classes="hud icon" Content="◎" Click="OnFitClick" AutomationProperties.Name="Fit workspace" />
        <Button Classes="hud icon" Content="+" Click="OnZoomInClick" AutomationProperties.Name="Zoom in" />
      </StackPanel>
    </Border>
    <Border x:Name="StatusPanel" Classes="floating" Padding="14,6" Margin="185,0,24,20" MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <TextBlock x:Name="StatusText" Text="Choose a folder to begin." FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <Border x:Name="MinimalSearchPanel" Classes="floating" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16" Padding="4">
      <Grid ColumnDefinitions="*,44" Width="340">
        <TextBox x:Name="MinimalSearchBox" Classes="hud" PlaceholderText="Search workspace" KeyDown="OnMinimalSearchKeyDown" TextChanged="OnSearchTextChanged" AutomationProperties.Name="Search with controls hidden" />
        <Button Grid.Column="1" Classes="hud icon" Content="◫" Click="OnInterfaceToggleClick" AutomationProperties.Name="Show controls" />
      </Grid>
    </Border>
  </Grid>
</Window>
