<Project>
  <PropertyGroup>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>nebula.4</VersionSuffix>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Title>OmniBrille</Title>
    <Product>OmniBrille</Product>
    <Description>Local spatial folder workspace.</Description>
    <Authors>OmniBrille Contributors</Authors>
    <Company>OmniBrille Contributors</Company>
    <Copyright>Copyright (c) 2026 OmniBrille Contributors</Copyright>
    <RepositoryUrl>https://github.com/Dr-Amit-Lal/OmniBrille</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
